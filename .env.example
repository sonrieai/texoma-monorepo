NEXHEALTH_API_KEY=dXNlci0yMDU0LXNhbmRib3g.HHuwnAc6sjb1Rsig1jxNgg86lf3Do90H
NEXHEALTH_SUBDOMAIN=sonrie-ai-demo-practice
NEXHEALTH_LOCATION_ID=355746
NEXHEALTH_BASE_URL=https://nexhealth.info
NEXHEALTH_API_VERSION=v3.0.0
# Safe NexHealth request summaries in the terminal (dev default on; set 0 in production)
NEXHEALTH_DEBUG=0
# Optional clinic timezone for GET /appointments (e.g. America/Chicago)
NEXHEALTH_TIMEZONE=
# Comma-separated NexHealth appointment_type_id values for NP consult conversion KPIs
# Find IDs via GET /appointment_types or Visit mix on Overview
NEXHEALTH_NP_CONSULT_TYPE_IDS=
# Optional: fee schedule name substring to show as Fee 1 (default prefers "Office Fees")
# NEXHEALTH_FEE_SCHEDULE_PRIORITY=Office Fees

# --- Cursor MCP (nexhealth-mcp) ---
# 1) Install uv: irm https://astral.sh/uv/install.ps1 | iex
# 2) Install server: uv tool install git+https://github.com/ChrisKildunne/nexhealth-mcp.git
# 3) Keep keys in .env.local (this file) — scripts/run-nexhealth-mcp.ps1 loads them for .cursor/mcp.json
# 4) Restart Cursor → Settings → MCP → enable "nexhealth"
# MCP reads: NEXHEALTH_API_KEY (required), NEXHEALTH_SUBDOMAIN (optional), NEXHEALTH_TIMEZONE → TIMEZONE_OVERRIDE
# Note: MCP can book patients/appointments in OD; it cannot POST production/charges for the category donut.

# --- Open Dental MySQL MCP (opendental-mysql in .cursor/mcp.json) ---
# Local trial: localhost + demo. Office server over VPN: set host to server IP + opendental.
# OD_MYSQL_HOST=localhost
# OD_MYSQL_PORT=3306
# OD_MYSQL_USER=root
# OD_MYSQL_PASS=
# OD_MYSQL_DB=demo
# Read-only by default (recommended). Set true only for local dev experiments.
# MYSQL_ALLOW_INSERT=false
# MYSQL_ALLOW_UPDATE=false
# MYSQL_ALLOW_DELETE=false
# Install: Node.js only (npx pulls @benborla29/mcp-server-mysql). Restart Cursor → MCP → opendental-mysql.

# --- MongoDB Atlas warehouse (dashboard reads; NexHealth only via sync job) ---
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URL=...   # optional alias if you copy from Atlas as MONGODB_URL
# MONGODB_DB=open-dental-backup
# SYNC_NEXHEALTH_ENABLED=true
# SYNC_SECRET=generate-a-long-random-string
# Max NexHealth list pages per resource during sync (default 50; use `all` or `0` for 200-page cap)
# SYNC_NEXHEALTH_MAX_PAGES=50
# Full resync: re-fetch incremental resources from default window (backfills new Mongo fields)
# SYNC_NEXHEALTH_FULL=1   — or: npm run sync:nexhealth:full
# SYNC_CDT_CHART_JSON=1   — optional legacy Excel chart merge (default: categories from NexHealth ProcCat)
# Manual sync: npm run sync:nexhealth
# Export API JSON for field review: npm run export:nexhealth  (overwrites exports/nexhealth/*.json)
# HTTP sync: POST /api/sync/nexhealth with header x-sync-secret: $SYNC_SECRET
# Strip PHI at warehouse write (default on; set 0 only for local unsanitized debug)
# SYNC_STRIP_PHI=1
# Sign a MongoDB BAA: https://www.mongodb.com/products/platform/trust/hipaa
# NO-ePHI runbook: docs/HIPAA_NO_EPHI.md

# Dashboard login (MongoDB-backed — credentials live in dashboard_users collection)
# AUTH_EMAIL=admin@yourpractice.com
# AUTH_PASSWORD=choose-a-strong-password
# AUTH_SESSION_SECRET=generate-at-least-32-random-characters
# AUTH_USERNAME=admin
# RESET_TOKEN_SECRET=optional-separate-secret-for-password-reset-links
# Note: AUTH_EMAIL + AUTH_PASSWORD seed the first dashboard_users record only when the collection is empty.

# Password reset email (Mailgun — same pattern as Sonrie backend)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=m.sonrie.ai
# SENDER_EMAIL=security@m.sonrie.ai
# AUTH_SENDER_NAME=Texoma Dashboard
# PASSWORD_RESET_WEB_BASE_URL=https://your-dashboard-host.com

# GoHighLevel (phase later)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_BASE_URL=https://services.leadconnectorhq.com
# Optional: contact custom field that stores lead source label
GHL_SOURCE_CUSTOM_FIELD_ID=