# NP consult types are inferred from consult procedures at page load.

# --- Open Dental MySQL (required for dashboard KPIs) ---
# Local trial (laptop): host=localhost user=root db=demo — see docs/LOCAL_OPENDENTAL.md
# Office LAN (on OD server): host=127.0.0.1 user=kpi_readonly db=<FreeDentalConfig DatabaseName>
#   SQL template: scripts/sql/create-kpi-readonly.sql
#   Full runbook: docs/OFFICE_INSTALL.md
OD_MYSQL_HOST=localhost
OD_MYSQL_PORT=3306
OD_MYSQL_USER=kpi_readonly
OD_MYSQL_PASS=
OD_MYSQL_DB=opendental
# Optional clinic filter (comma-separated ClinicNum). Leave blank for all.
# OD_CLINIC_NUMS=
# PHI-safe probe: npm run probe:opendental-mysql
# Snapshot sanity: npm run validate:opendental
# LAN production listen: npm run start:lan  (0.0.0.0:8080)

# Display labels only
# WAREHOUSE_LOCATION_ID=1
# WAREHOUSE_SUBDOMAIN=opendental-local
# WAREHOUSE_LOCATION_NAME=Texoma Local

# --- Local JSON store (login users + saved GHL settings — not clinical KPIs) ---
# Default file: data/store.json (gitignored). Created on first login seed or GHL save.
# JSON_STORE_PATH=
# Local OD deploy: docs/LOCAL_OPENDENTAL.md
# SYNC_STRIP_PHI=1
# NO-ePHI runbook: docs/HIPAA_NO_EPHI.md

# Dashboard login (users live in the JSON store; first empty store seeds from these)
# AUTH_EMAIL=admin@yourpractice.com
# AUTH_PASSWORD=choose-a-strong-password
# AUTH_SESSION_SECRET=generate-at-least-32-random-characters
# AUTH_USERNAME=admin
# RESET_TOKEN_SECRET=optional-separate-secret-for-password-reset-links
# Note: AUTH_EMAIL + AUTH_PASSWORD seed the first dashboard user only when the JSON store has no users.

# Password reset email (Mailgun — same pattern as Sonrie backend)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=m.sonrie.ai
# SENDER_EMAIL=security@m.sonrie.ai
# AUTH_SENDER_NAME=Texoma Dashboard
# PASSWORD_RESET_WEB_BASE_URL=https://texoma.vercel.app

# Open Dental Remote API (optional — not wired to dashboard yet)
# Public sandbox probe: npm run probe:opendental
# Live keys come from api.opendental.com/portal after Vendor Relations approval
# OPENDENTAL_DEVELOPER_KEY=
# OPENDENTAL_CUSTOMER_KEY=
# OPENDENTAL_BASE_URL=https://api.opendental.com/api/v1

# Google Maps basemap for Patients by Area (/geo)
# Next.js reads REACT_APP_GOOGLE_MAPS_API_KEY (CRA-style) or NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
REACT_APP_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# GoHighLevel — marketing funnel + TC patient journey (live API, not warehouse)
# Admins can save credentials in Settings → GoHighLevel (encrypted in the JSON store).
# Env vars below are the fallback when no saved JSON settings exist.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_BASE_URL=https://services.leadconnectorhq.com
# Private Integration scopes: Opportunities (read) + adPublishing.readonly for Marketing spend/ROI
# Optional: contact custom field that stores lead source label
GHL_SOURCE_CUSTOM_FIELD_ID=
# Optional: separate key for encrypting integration_settings (defaults to AUTH_SESSION_SECRET)
# INTEGRATION_ENCRYPTION_KEY=