# NP consult types are inferred from consult procedures at page load.

# --- Open Dental MySQL (required for dashboard KPIs) ---
# Local trial (laptop): host=localhost user=root db=demo — see docs/LOCAL_OPENDENTAL.md
# Office LAN (on OD server): host=127.0.0.1 user=kpi_readonly db=<FreeDentalConfig DatabaseName>
#   SQL template: scripts/sql/create-kpi-readonly.sql
#   Full runbook: docs/OFFICE_INSTALL.md
OD_MYSQL_HOST=localhost
OD_MYSQL_PORT=3306
OD_MYSQL_USER=kpi_readonly
OD_MYSQL_PASS=
OD_MYSQL_DB=opendental
# Optional clinic filter (comma-separated ClinicNum). Leave blank for all.
# OD_CLINIC_NUMS=
# PHI-safe probe: npm run probe:opendental-mysql
# Snapshot sanity: npm run validate:opendental
# LAN production listen: npm run start:lan  (0.0.0.0:8080)

# Display labels only
# WAREHOUSE_LOCATION_ID=1
# WAREHOUSE_SUBDOMAIN=opendental-local
# WAREHOUSE_LOCATION_NAME=Texoma Local

# --- MongoDB (login users, password resets, saved GHL settings, OD→GHL sync cursor) ---
# Clinical KPIs stay on Open Dental MySQL.
# MONGODB_URI=
# MONGODB_URL=
# MONGODB_DB=opendental_dev
# JSON_STORE_PATH is only for tests. The app uses Mongo when MONGODB_URL is set.
# Local OD deploy: docs/LOCAL_OPENDENTAL.md
# SYNC_STRIP_PHI=1
# NO-ePHI runbook: docs/HIPAA_NO_EPHI.md

# Dashboard login (users live in MongoDB; first empty database seeds from these)
# AUTH_EMAIL=admin@yourpractice.com
# AUTH_PASSWORD=choose-a-strong-password
# AUTH_SESSION_SECRET=generate-at-least-32-random-characters
# AUTH_USERNAME=admin
# RESET_TOKEN_SECRET=optional-separate-secret-for-password-reset-links
# Note: AUTH_EMAIL + AUTH_PASSWORD seed the first dashboard user only when Mongo has no users.

# Password reset email (Mailgun SMTP). Port 587 uses STARTTLS; 465 is implicit TLS.
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=contact@smiletexoma.com
# SMTP_PASS=
# SENDER_EMAIL=contact@smiletexoma.com
# AUTH_SENDER_NAME=Texoma Dashboard
# PASSWORD_RESET_WEB_BASE_URL=https://texoma.vercel.app
# Optional HTTP API fallback when SMTP is not set:
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=m.sonrie.ai

# Open Dental Remote API (optional — not wired to dashboard yet)
# Public sandbox probe: npm run probe:opendental
# Live keys come from api.opendental.com/portal after Vendor Relations approval
# OPENDENTAL_DEVELOPER_KEY=
# OPENDENTAL_CUSTOMER_KEY=
# OPENDENTAL_BASE_URL=https://api.opendental.com/api/v1

# Google Maps basemap for Patients by Area (/geo)
# Next.js reads REACT_APP_GOOGLE_MAPS_API_KEY (CRA-style) or NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
REACT_APP_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# GoHighLevel — marketing funnel + TC patient journey (live API, not warehouse)
# Admins can save credentials in Settings → GoHighLevel (encrypted in MongoDB).
# Env vars below are the fallback when no saved Mongo settings exist.
GHL_API_KEY=
# Texoma Dentures & Implants only (OD sync refuses any other locationId)
GHL_LOCATION_ID=m7Fk4S7LR8eTebuM3QPh
GHL_BASE_URL=https://services.leadconnectorhq.com
# Private Integration scopes: Opportunities (read) + adPublishing.readonly for Marketing spend/ROI
# Optional: contact custom field that stores lead source label
GHL_SOURCE_CUSTOM_FIELD_ID=
# OD → GHL sync (Texoma): calendar + custom field ids
GHL_CALENDAR_ID=
GHL_ASSIGNED_USER_ID=
GHL_OD_PATNUM_FIELD_ID=
GHL_OD_APTNUM_FIELD_ID=
GHL_OD_LAST_SYNC_FIELD_ID=
GHL_OD_CONSULT_DATE_FIELD_ID=
GHL_OD_MISSED_APPT_DATE_FIELD_ID=
GHL_OD_NEXT_APPT_DATE_FIELD_ID=
GHL_ACTIVE_SEQUENCE_FIELD_ID=
# Location custom value id for od_sync_last_success (sync heartbeat)
GHL_OD_SYNC_LAST_SUCCESS_VALUE_ID=
# Treatment Coordinator + Leads pipelines (dashboard funnel reads by id)
GHL_TC_PIPELINE_ID=suRYSJn1pEqxFgVtWPHi
GHL_LEADS_PIPELINE_ID=nk8ZbJEWH0dk62iUGwc8
# Missed consult → Leads Pipeline No-Show/Cancellation (not deleted TC stage)
GHL_LEADS_NO_SHOW_STAGE_ID=ce2067f3-7e1a-4293-b476-e7b4834bc307
# TC coordinator GHL user ids (item 7)
# GHL_COORDINATOR_ASHLIE_USER_ID=9aIuM8iB5oX6dTHXh262
# GHL_COORDINATOR_BRIE_USER_ID=MZpXcUFbXCGyFQNIoVLP
# Password reset / canonical app URL (office LAN — not Vercel)
# PASSWORD_RESET_WEB_BASE_URL=http://your-office-server:8080
# PRODUCTION_APP_URL=
# Set to 1 for dry-run counts with no GHL writes
# GHL_OD_SYNC_DRY_RUN=1
# Daily dashboard snapshot file (06:00 America/Chicago job)
# OD_DASHBOARD_SNAPSHOT_PATH=
# OD_GHL_SYNC_STATE_PATH=
# E2E OD→GHL writes (restored MySQL copy — not SELECT-only live)
# OD_GHL_E2E_MYSQL_HOST=
# OD_GHL_E2E_MYSQL_PORT=3306
# OD_GHL_E2E_MYSQL_USER=
# OD_GHL_E2E_MYSQL_PASS=
# OD_GHL_E2E_MYSQL_DB=
# Optional: separate key for encrypting integration_settings (defaults to AUTH_SESSION_SECRET)
# INTEGRATION_ENCRYPTION_KEY=